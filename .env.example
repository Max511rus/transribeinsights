# ============================================
# Transcribe & Insight — Конфигурация
# Скопируйте в .env и заполните значения
# ============================================

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_UPLOAD_MB=25
GROQ_CHUNK_SIZE_MB=20
GROQ_MAX_RETRIES=3
GROQ_RETRY_DELAY=5

# --- Telegram Bot ---
BOT_TOKEN=your_telegram_bot_token_here
BOT_ALLOWED_USERS=
# Оставьте пустым, чтобы разрешить всем, или укажите ID через запятую: 123456,789012

# --- VPN / прокси ---
# Если Telegram или Groq с сервера напрямую недоступны (Groq отвечает 403
# из некоторых стран), укажите локальный прокси VPN, например Xray:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# GROQ_PROXY=socks5://127.0.0.1:1080
TELEGRAM_PROXY=
GROQ_PROXY=

# --- HTTP API ---
API_AUTH_TOKEN=generate_with_openssl_rand_hex_32
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=https://your-domain.com,http://localhost:3000

# --- Обработка файлов ---
MAX_FILE_SIZE_MB=25
MAX_PROCESSING_MINUTES=30
SUPPORTED_AUDIO_EXTENSIONS=mp3,wav,ogg,m4a,flac,aac,wma
SUPPORTED_VIDEO_EXTENSIONS=mp4,avi,mkv,mov,webm,flv,wmv

# --- LLM ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
LLM_CHUNK_SIZE=12000
LLM_CHUNK_OVERLAP=500

# --- Хранение данных ---
DATA_DIR=./data
RETENTION_HOURS=24

# --- Логирование ---
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false

# --- PDF ---
PDF_FONT_FAMILY=Noto Sans
PDF_PAGE_FORMAT=A4
