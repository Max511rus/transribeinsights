[Unit]
Description=Transcribe & Insight — HTTP API
After=network.target

[Service]
Type=simple
User=transcribe
Group=transcribe
WorkingDirectory=/opt/transcribe-insight
Environment="PATH=/opt/transcribe-insight/venv/bin"
ExecStart=/opt/transcribe-insight/venv/bin/uvicorn api.app:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=transcribe-api

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
